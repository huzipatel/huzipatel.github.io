---
import Base from '../../layouts/Base.astro';
---
<Base title="Not found" noindex={true}>
  <div class="max-w-xl mx-auto px-5 py-32 text-center">
    <div class="font-mono text-xs text-accent mb-4 tracking-[0.2em] uppercase">// 404</div>
    <h1 class="font-display text-4xl text-head mb-4">Pitch not found</h1>
    <p class="text-mute mb-8">This link is either expired, mistyped, or never existed. If you were sent it directly, ping Huzi for a fresh one.</p>
    <a href="/" class="inline-flex items-center gap-2 bg-accent text-ink px-5 py-3 rounded-md font-medium hover:bg-accent/90 transition-colors">
      huzipatel.london
    </a>
  </div>
</Base>
