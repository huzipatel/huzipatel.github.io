---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.ts';

const experience = [
  {
    org: 'UK local authority',
    role: 'Solution Architect / IoT Tech Lead',
    period: 'Jan 2024 — Present',
    location: 'London, UK',
    bullets: [
      'Conceived and delivered a self-directed revenue initiative — vision-language model over street-level imagery — that surfaced a seven-figure annual uplift in rateable value. Now being commercialised to other UK authorities.',
      'Recovered a city-scale LoRaWAN gateway estate from supplier lock-in; six-figure saving ahead of re-tender.',
      'Orchestrated a shared computer-vision platform (bin-truck vision) via high-level design and cross-functional championing.',
      'Pioneered a prototype-driven product development process with service teams.',
      "Spearheaded the organisation's IoT Maturity Model, reducing vendor lock-in and improving rationalisation.",
      'Led technical architecture for the organisation\'s participation in a city-wide public WiFi programme.',
      'Stepped in as data engineer during a short-staffed stretch — Python + Kubernetes cron jobs on Azure ingesting third-party time-series APIs into InfluxDB — preventing a 3-month roadmap slip.',
    ],
  },
  {
    org: 'Banner Chemicals',
    role: 'Account Manager',
    period: 'Feb 2023 — Jan 2024',
    location: 'Runcorn, UK',
    bullets: [
      'Managed a 35-account manufacturing and aerospace territory; surpassed targets by securing agreements with mid-market and large multinationals through precision-cleaning process optimisation.',
    ],
  },
  {
    org: 'Connexin',
    role: 'IoT Solutions Architect',
    period: 'Feb 2021 — Jul 2022',
    location: 'Hull, UK',
    bullets: [
      'Architected end-to-end Smart City solutions from IoT sensors and Edge AI to LoRaWAN / 5G and enterprise apps; supported a winning RFP for 150,000+ water meters.',
      'Overhauled Smart Waste platform strategy to resolve critical client disputes; pivoted accounts to collaborative relationships (~28% performance improvement).',
    ],
  },
  {
    org: 'Remote Sense',
    role: 'Solutions Architect',
    period: 'May 2020 — Dec 2020',
    location: 'London, UK',
    bullets: [
      'Partnered with a global systems integrator to architect and deliver a real-time, serverless oil-condition monitoring platform for a multinational miner across African sites.',
    ],
  },
  {
    org: 'Imperial Consulting Group',
    role: 'Engagement Manager',
    period: 'Feb 2018 — Apr 2019',
    location: 'London, UK',
    bullets: [
      'Delivered three strategy consulting projects for London and Cambridge startups as associate, project manager and engagement manager — primarily market sizing to support investor decks.',
    ],
  },
];
---
<Base>
  <!-- HERO -->
  <section class="max-w-5xl mx-auto px-5 pt-20 pb-24">
    <div class="font-mono text-xs text-accent mb-6 tracking-wide">
      <span class="opacity-60">#</span> solution architect / applied ai
    </div>
    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl text-head leading-[1.05] tracking-tight mb-8">
      I turn <em class="text-accent not-italic">AI prototypes</em> into
      shipped products inside messy, high-stakes organisations.
    </h1>
    <p class="text-lg text-mute max-w-2xl leading-relaxed mb-10">
      I'm Huzi. Currently solution architect and IoT tech lead at a UK local authority — most recently I used a vision-language model over street-level imagery to surface a seven-figure annual uplift in business rates, then turned the prototype into a shipped product. Before that: Smart City architecture at Connexin, serverless industrial IoT at Remote Sense. MEng, Imperial College London.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="#work" class="inline-flex items-center gap-2 bg-accent text-ink px-4 py-2.5 rounded-md font-medium hover:bg-accent/90 transition-colors">
        See the work
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="mailto:huzaifa@live.co.uk" class="inline-flex items-center gap-2 border border-line text-head px-4 py-2.5 rounded-md font-medium hover:border-accent transition-colors">
        Get in touch
      </a>
    </div>

    <!-- stats strip -->
    <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-6 border-t border-line pt-8">
      <div>
        <div class="font-display text-3xl text-head">7-figure</div>
        <div class="text-xs text-mute mt-1">annual rateable value uplift</div>
      </div>
      <div>
        <div class="font-display text-3xl text-head">6-figure</div>
        <div class="text-xs text-mute mt-1">saved via IoT estate recovery</div>
      </div>
      <div>
        <div class="font-display text-3xl text-head">150k+</div>
        <div class="text-xs text-mute mt-1">water meters in winning RFP</div>
      </div>
      <div>
        <div class="font-display text-3xl text-head">6 yrs</div>
        <div class="text-xs text-mute mt-1">solution architecture</div>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="max-w-5xl mx-auto px-5 py-16 scroll-mt-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <div class="font-mono text-xs text-accent mb-2">// selected work</div>
        <h2 class="font-display text-4xl text-head">Case studies</h2>
      </div>
      <div class="text-sm text-mute hidden sm:block">{projects.length} projects</div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {projects.map((p, i) => (
        <a href={`/work/${p.slug}/`} class="group block bg-panel hover:bg-panel-2 border border-line hover:border-accent/40 rounded-lg p-6 transition-colors shadow-card">
          <div class="flex items-center justify-between mb-5">
            <span class="font-mono text-xs text-mute">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-xs text-mute">{p.period}</span>
          </div>
          <h3 class="font-display text-2xl text-head leading-snug mb-2 group-hover:text-accent transition-colors">
            {p.title}
          </h3>
          <div class="text-xs font-mono text-mute mb-4">{p.org}</div>
          <p class="text-sm text-text leading-relaxed mb-5">{p.tagline}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map(t => (
              <span class="text-[11px] font-mono text-mute border border-line rounded px-2 py-1">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="max-w-5xl mx-auto px-5 py-16 scroll-mt-20">
    <div class="font-mono text-xs text-accent mb-2">// experience</div>
    <h2 class="font-display text-4xl text-head mb-10">Where I've worked</h2>
    <ol class="space-y-10">
      {experience.map(e => (
        <li class="grid md:grid-cols-[180px_1fr] gap-6 md:gap-10">
          <div class="text-sm">
            <div class="font-mono text-xs text-mute">{e.period}</div>
            <div class="text-xs text-mute mt-1">{e.location}</div>
          </div>
          <div>
            <div class="font-display text-xl text-head leading-tight">{e.role}</div>
            <div class="text-sm text-accent font-mono mb-4">{e.org}</div>
            <ul class="space-y-2">
              {e.bullets.map(b => (
                <li class="text-sm text-text leading-relaxed flex gap-3">
                  <span class="text-accent mt-1.5 shrink-0">▹</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ABOUT / SKILLS -->
  <section id="about" class="max-w-5xl mx-auto px-5 py-16 scroll-mt-20">
    <div class="grid md:grid-cols-2 gap-10">
      <div>
        <div class="font-mono text-xs text-accent mb-2">// about</div>
        <h2 class="font-display text-4xl text-head mb-6">Background</h2>
        <div class="space-y-4 text-text leading-relaxed">
          <p>
            MEng Chemical with Nuclear Engineering, Imperial College London (2:1, 66%). McNab Lacey Prize — 1st place out of all UK universities for designing an innovative process converting waste wood into jet fuel.
          </p>
          <p>
            A-Levels: Mathematics (A*), Chemistry (A*), Biology (A*), Physics (A) — Canon Slade Sixth Form, Bolton.
          </p>
          <p class="text-mute">
            Languages: English (native), Gujarati (fluent), Hindi (fluent).
          </p>
        </div>
      </div>
      <div>
        <div class="font-mono text-xs text-accent mb-2">// skills</div>
        <h2 class="font-display text-4xl text-head mb-6">What I work with</h2>
        <dl class="space-y-5 text-sm">
          <div>
            <dt class="font-mono text-xs text-mute mb-1.5">Architecture</dt>
            <dd class="text-text">Solution &amp; Enterprise Architecture · Business Architecture · TDF / ARB Governance · C4 Model · Threat Modelling · Supplier Selection · Confluence · Lucidchart</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-mute mb-1.5">Product</dt>
            <dd class="text-text">Portfolio Strategy · Backlog &amp; Sprint Planning · Jira</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-mute mb-1.5">Cloud &amp; Infrastructure</dt>
            <dd class="text-text">AWS Certified Solution Architect Associate (2022) · Azure · GCP · FinOps · Kubernetes · Docker · IaC · LoRaWAN</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-mute mb-1.5">Data &amp; Engineering</dt>
            <dd class="text-text">ADF · Snowflake · Python · Claude · Hermes · OpenAI · InfluxDB · Grafana · Power BI</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-5 py-20">
    <div class="bg-panel border border-line rounded-xl p-8 sm:p-12 text-center">
      <div class="font-mono text-xs text-accent mb-4">// let's talk</div>
      <h2 class="font-display text-3xl sm:text-4xl text-head mb-4">
        Building something that needs a solution architect?
      </h2>
      <p class="text-mute max-w-xl mx-auto mb-8">
        Applied AI, IoT platforms, public-sector delivery, or getting a messy AI prototype across the line to production. Happy to chat.
      </p>
      <a href="mailto:huzaifa@live.co.uk" class="inline-flex items-center gap-2 bg-accent text-ink px-5 py-3 rounded-md font-medium hover:bg-accent/90 transition-colors">
        huzaifa@live.co.uk
      </a>
    </div>
  </section>
</Base>
