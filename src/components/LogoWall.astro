---
/**
 * Employer marks: unified monogram SVGs in a disciplined geometric style.
 * Decision: custom marks > fetched logos. Fetched logos were a mess of
 * mismatched quality (pngs at wrong DPI, Wikipedia 404s, html-error-page SVGs).
 * A unified mark system reads as a design decision, not a shortcut.
 */
import { employers } from '../data/employers.ts';

interface Props {
  variant?: 'strip' | 'grid';
}
const { variant = 'strip' } = Astro.props;

// Each mark is a distinct geometric treatment of the initial(s).
// All sit on a 40×40 canvas, 2px stroke, currentColor.
const marks: Record<string, string> = {
  // Westminster — "W" as crenellated arches, nodding to municipal heritage
  westminster: `
    <rect x="1" y="1" width="38" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <path d="M9 28 L11 12 L14 20 L17 12 L20 24 L23 12 L26 20 L29 12 L31 28 Z"
          fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <circle cx="20" cy="31" r="0.8" fill="currentColor"/>
  `,
  // Connexin — "C" as connected nodes, nodding to networking
  connexin: `
    <rect x="1" y="1" width="38" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <circle cx="13" cy="13" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="27" cy="13" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="13" cy="27" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="27" cy="27" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path d="M13 15.5 L13 24.5 M15.5 13 L24.5 13 M15.5 27 L24.5 27" stroke="currentColor" stroke-width="1.5" fill="none"/>
  `,
  // Remote Sense — radar sweep
  remotesense: `
    <rect x="1" y="1" width="38" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <circle cx="20" cy="20" r="12" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5"/>
    <circle cx="20" cy="20" r="7" fill="none" stroke="currentColor" stroke-width="1" opacity="0.7"/>
    <circle cx="20" cy="20" r="2" fill="currentColor"/>
    <path d="M20 20 L31 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  `,
  // Banner Chemicals — hex / molecular
  banner: `
    <rect x="1" y="1" width="38" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <polygon points="20,8 29,13 29,24 20,30 11,24 11,13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <circle cx="20" cy="19" r="2" fill="currentColor"/>
  `,
  // Imperial — crest-inspired geometric crown
  imperial: `
    <rect x="1" y="1" width="38" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <path d="M9 28 L9 15 L14 19 L20 11 L26 19 L31 15 L31 28 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M9 28 L31 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  `,
};
---
{variant === 'strip' ? (
  <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8">
    {employers.map(e => (
      <li class="flex items-center gap-3 text-mute hover:text-head transition-colors">
        <svg class="w-8 h-8 shrink-0" viewBox="0 0 40 40" aria-hidden="true" set:html={marks[e.key]} />
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase leading-tight">
          <span class="text-head block">{e.name}</span>
          {e.sub && <span class="opacity-70">{e.sub}</span>}
        </div>
      </li>
    ))}
  </ul>
) : (
  <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-line border border-line rounded-lg overflow-hidden">
    {employers.map(e => (
      <li class="bg-panel aspect-[4/3] flex flex-col items-center justify-center text-center px-4 py-6 group hover:bg-panel-2 transition-colors">
        <svg class="w-12 h-12 text-accent mb-4 group-hover:scale-110 transition-transform" viewBox="0 0 40 40" aria-hidden="true" set:html={marks[e.key]} />
        <div class="font-display text-lg text-head leading-tight">
          {e.name}
          {e.sub && <div class="text-xs text-mute font-sans not-italic mt-0.5">{e.sub}</div>}
        </div>
        <div class="mt-3 font-mono text-[9px] tracking-[0.18em] uppercase text-mute">
          {e.role}
        </div>
      </li>
    ))}
  </ul>
)}
